---
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionGrid from "../components/CollectionGrid.astro";
import { sanityClient } from "../lib/sanity";

// Top-level galleries only. A gallery referenced as another gallery's parent
// is a "category" and links to its own page listing child galleries; the
// cover falls back to the first photo, or a child's first photo.
const galleries = await sanityClient.fetch(`
*[_type == "gallery" && !defined(parent) && defined(slug.current)] | order(title asc) {
  title,
  description,
  "slug": slug.current,
  "isCategory": count(*[_type == "gallery" && parent._ref == ^._id]) > 0,
  "coverImage": coalesce(
    coverImage.asset->url,
    photographs[0]->image.asset->url,
    (*[_type == "gallery" && parent._ref == ^._id] | order(title asc)[0].photographs[0]->image.asset->url)
  ),
  "coverAlt": coalesce(photographs[0]->altText, title)
}
`);

const items = galleries.map((gallery) => ({
  title: gallery.title,
  description: gallery.description,
  href: `/gallery/${gallery.slug}/`,
  coverImage: gallery.coverImage,
  coverAlt: gallery.coverAlt,
  cta: gallery.isCategory ? "Explore category →" : "Explore gallery →",
}));
---

<BaseLayout
  title="Gallery"
  description="Explore wildlife, landscapes, and places photographed by Jay Brass."
>
  <main class="gallery-page">
    <header class="gallery-header">
      <h1>Gallery</h1>
      <p>Explore wildlife, landscapes, and places through photography.</p>
    </header>

    <CollectionGrid items={items} />
  </main>

  <style>
    .gallery-page {
      width: min(1200px, 92%);
      margin: 0 auto;
      padding: 2rem 0 4rem;
    }

    .gallery-header {
      margin-bottom: 2rem;
    }

    .gallery-header h1 {
      margin-bottom: 0.5rem;
    }

    .gallery-header p {
      max-width: 650px;
      line-height: 1.6;
    }
  </style>
</BaseLayout>
