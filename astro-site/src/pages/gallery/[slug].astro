---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanityClient } from "../../lib/sanity";

export async function getStaticPaths() {
const galleries = await sanityClient.fetch(`
*[_type == "gallery" && defined(slug.current)] {
"slug": slug.current
}
`)                                               ;

return galleries.map((gallery) => ({
params: { slug: gallery.slug },
}))                                  ;
}

const { slug } = Astro.params ;

const gallery = await sanityClient.fetch(
`
*[_type == "gallery" && slug.current == $slug][0] {
title,
description,
"photographs": photographs[]-> {
title,
location,
altText,
"slug": slug.current,
"imageUrl": image.asset->url,
"width": image.asset->metadata.dimensions.width,
"height": image.asset->metadata.dimensions.height
}
}
`,
{ slug }
)                                                   ;

if (!gallery) {
Astro.response.status = 404 ;
}

const pageDescription =
gallery?.description || "Photography by Jay Brass.";

function splitIntoColumns(items, count) {
const columns = Array.from({ length: count }, () => []) ;

items.forEach((item, index) => {
let columnIndex                  ;

if (count === 3) {
// Desktop: place the fourth image in column 2.
const desktopOrder = [0, 1, 2, 1, 0, 2]                 ;
columnIndex = desktopOrder[index % desktopOrder.length] ;
} else if (count === 2) {
// Tablet: alternate columns.
columnIndex = index % 2                                 ;
} else {
// Mobile: keep the original order.
columnIndex = 0                                         ;
}

columns[columnIndex].push(item) ;
})                              ;

return columns ;
}

const photographs = gallery?.photographs ?? [] ;

const desktopColumns = splitIntoColumns(photographs, 3) ;
const tabletColumns = splitIntoColumns(photographs, 2)  ;
const mobileColumns = splitIntoColumns(photographs, 1)  ;
---

<BaseLayout
title={gallery ? `${gallery.title} | Gallery` : "Gallery Not Found"}
description={pageDescription}
>
<main class="gallery-detail">
{gallery ? (
<>
<nav class="breadcrumb" aria-label="Breadcrumb">
<a href="/gallery/">Gallery</a>
<span aria-hidden="true"> / </span>
<span aria-current="page">{gallery.title}</span>
</nav>

<header class="gallery-header">
<h1>{gallery.title}</h1>
{gallery.description && <p>{gallery.description}</p>}
</header>

{photographs.length > 0 ? (
<>
<!-- Desktop: three explicit columns -->
<div class="masonry masonry--desktop">
{desktopColumns.map((column) => (
<div class="masonry__col">
{column.map((photo) => (
<a
href={`/gallery/${slug}/${photo.slug}/`}
class="photo-link"
>
<figure>
<img
src={photo.imageUrl}
alt={photo.altText || photo.title || ""}
loading="lazy"
/>
{(photo.title || photo.location) && (
<figcaption>
{photo.title && <strong>{photo.title}</strong>}
{photo.location && <span>{photo.location}</span>}
</figcaption>
)}
</figure>
</a>
))}
</div>
))}
</div>

<!-- Tablet: two explicit columns -->
<div class="masonry masonry--tablet">
{tabletColumns.map((column) => (
<div class="masonry__col">
{column.map((photo) => (
<a
href={`/gallery/${slug}/${photo.slug}/`}
class="photo-link"
>
<figure>
<img
src={photo.imageUrl}
alt={photo.altText || photo.title || ""}
loading="lazy"
/>
{(photo.title || photo.location) && (
<figcaption>
{photo.title && <strong>{photo.title}</strong>}
{photo.location && <span>{photo.location}</span>}
</figcaption>
)}
</figure>
</a>
))}
</div>
))}
</div>

<!-- Mobile: one column in original photo order -->
<div class="masonry masonry--mobile">
{mobileColumns.map((column) => (
<div class="masonry__col">
{column.map((photo) => (
<a
href={`/gallery/${slug}/${photo.slug}/`}
class="photo-link"
>
<figure>
<img
src={photo.imageUrl}
alt={photo.altText || photo.title || ""}
loading="lazy"
/>
{(photo.title || photo.location) && (
<figcaption>
{photo.title && <strong>{photo.title}</strong>}
{photo.location && <span>{photo.location}</span>}
</figcaption>
)}
</figure>
</a>
))}
</div>
))}
</div>
</>
) : (
<p>Photographs for this gallery will be added soon.</p>
)}

<p class="back-link">
<a href="/gallery/">← Back to all galleries</a>
</p>
</>
) : (
<>
<h1>Gallery not found</h1>
<p>This gallery may have moved or no longer exists.</p>
<a href="/gallery/">Return to Gallery</a>
</>
)}
</main>

<style>
.gallery-detail {
width: min(1200px, 92%) ;
margin: 0 auto          ;
padding: 2rem 0 4rem    ;
}

.breadcrumb {
margin-bottom: 1.5rem ;
font-size: 0.9rem     ;
}

.breadcrumb a,
.back-link a {
color: inherit             ;
text-underline-offset: 3px ;
}

.gallery-header {
margin-bottom: 2rem ;
}

.gallery-header p {
max-width: 700px    ;
line-height: 1.6    ;
}

.masonry {
display: flex           ;
align-items: flex-start ;
gap: 30px               ;
}

.masonry__col {
display: grid   ;
flex: 1         ;
min-width: 0    ;
gap: 30px       ;
}

.masonry figure {
min-width: 0      ;
margin: 0         ;
}

.masonry img {
display: block    ;
width: 100%       ;
height: auto      ;
border: 1px solid #ddd;
}

.masonry figcaption {
display: flex          ;
flex-direction: column ;
gap: 0.25rem           ;
margin-top: 0.5rem     ;
font-size: 0.9rem      ;
line-height: 1.45      ;
}

.masonry--tablet,
.masonry--mobile {
display: none      ;
}

.back-link {
margin-top: 2.5rem ;
}

@media (max-width: 900px) {
.masonry--desktop {
display: none               ;
}

.masonry--tablet {
display: flex      ;
}

.masonry {
gap: 20px  ;
}

.masonry__col {
gap: 24px       ;
}
}

@media (max-width: 520px) {
.masonry--tablet {
display: none               ;
}

.masonry--mobile {
display: flex      ;
}

.masonry {
gap: 0     ;
}

.masonry__col {
gap: 28px       ;
}
}
</style>
</BaseLayout>
