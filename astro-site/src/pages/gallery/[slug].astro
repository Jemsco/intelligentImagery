---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanityClient } from "../../lib/sanity";
import "photoswipe/style.css";

export async function getStaticPaths() {
const galleries = await sanityClient.fetch(`
*[_type == "gallery" && defined(slug.current)] {
"slug": slug.current
}
`)                                               ;

return galleries.map((gallery) => ({
params: { slug: gallery.slug },
}))                                  ;
}

const { slug } = Astro.params ;

const gallery = await sanityClient.fetch(
`
*[_type == "gallery" && slug.current == $slug][0] {
title,
description,
"photographs": photographs[]-> {
title,
location,
altText,
"slug": slug.current,
"imageUrl": image.asset->url,
"width": image.asset->metadata.dimensions.width,
"height": image.asset->metadata.dimensions.height
}
}
`,
{ slug }
)                                                   ;

if (!gallery) {
Astro.response.status = 404 ;
}

const pageDescription =
gallery?.description || "Photography by Jay Brass.";

function splitIntoColumns(items, count) {
const columns = Array.from({ length: count }, () => []) ;

items.forEach((item, index) => {
let columnIndex                  ;

if (count === 3) {
// Desktop: place the fourth image in column 2.
const desktopOrder = [0, 1, 2, 1, 0, 2]                 ;
columnIndex = desktopOrder[index % desktopOrder.length] ;
} else if (count === 2) {
// Tablet: alternate columns.
columnIndex = index % 2                                 ;
} else {
// Mobile: keep the original order.
columnIndex = 0                                         ;
}

columns[columnIndex].push(item) ;
})                              ;

return columns ;
}

const photographs = gallery?.photographs ?? [] ;

// Ordered list consumed by the PhotoSwipe lightbox. width/height are
// required by PhotoSwipe to size each slide and enable zoom.
const modalPhotos = photographs.map((photo) => ({
slug: photo.slug,
imageUrl: photo.imageUrl,
width: photo.width ?? 1600,
height: photo.height ?? 1067,
alt: photo.altText || photo.title || "",
title: photo.title || "",
location: photo.location || "",
}))                                               ;

const desktopColumns = splitIntoColumns(photographs, 3) ;
const tabletColumns = splitIntoColumns(photographs, 2)  ;
const mobileColumns = splitIntoColumns(photographs, 1)  ;
---

<BaseLayout
title={gallery ? `${gallery.title} | Gallery` : "Gallery Not Found"}
description={pageDescription}
>
<main class="gallery-detail">
{gallery ? (
<>
<nav class="breadcrumb" aria-label="Breadcrumb">
<a href="/gallery/">Gallery</a>
<span aria-hidden="true"> / </span>
<span aria-current="page">{gallery.title}</span>
</nav>

<header class="gallery-header">
<h1>{gallery.title}</h1>
{gallery.description && <p>{gallery.description}</p>}
</header>

{photographs.length > 0 ? (
<>
<!-- Desktop: three explicit columns -->
<div class="masonry masonry--desktop">
{desktopColumns.map((column) => (
<div class="masonry__col">
{column.map((photo) => (
<a
href={`/gallery/${slug}/${photo.slug}/`}
class="photo-link"
data-photo-slug={photo.slug}
>
<figure>
<img
src={photo.imageUrl}
alt={photo.altText || photo.title || ""}
loading="lazy"
/>
{(photo.title || photo.location) && (
<figcaption>
{photo.title && <strong>{photo.title}</strong>}
{photo.location && <span>{photo.location}</span>}
</figcaption>
)}
</figure>
</a>
))}
</div>
))}
</div>

<!-- Tablet: two explicit columns -->
<div class="masonry masonry--tablet">
{tabletColumns.map((column) => (
<div class="masonry__col">
{column.map((photo) => (
<a
href={`/gallery/${slug}/${photo.slug}/`}
class="photo-link"
data-photo-slug={photo.slug}
>
<figure>
<img
src={photo.imageUrl}
alt={photo.altText || photo.title || ""}
loading="lazy"
/>
{(photo.title || photo.location) && (
<figcaption>
{photo.title && <strong>{photo.title}</strong>}
{photo.location && <span>{photo.location}</span>}
</figcaption>
)}
</figure>
</a>
))}
</div>
))}
</div>

<!-- Mobile: one column in original photo order -->
<div class="masonry masonry--mobile">
{mobileColumns.map((column) => (
<div class="masonry__col">
{column.map((photo) => (
<a
href={`/gallery/${slug}/${photo.slug}/`}
class="photo-link"
data-photo-slug={photo.slug}
>
<figure>
<img
src={photo.imageUrl}
alt={photo.altText || photo.title || ""}
loading="lazy"
/>
{(photo.title || photo.location) && (
<figcaption>
{photo.title && <strong>{photo.title}</strong>}
{photo.location && <span>{photo.location}</span>}
</figcaption>
)}
</figure>
</a>
))}
</div>
))}
</div>
</>
) : (
<p>Photographs for this gallery will be added soon.</p>
)}

<p class="back-link">
<a href="/gallery/">← Back to all galleries</a>
</p>
</>
) : (
<>
<h1>Gallery not found</h1>
<p>This gallery may have moved or no longer exists.</p>
<a href="/gallery/">Return to Gallery</a>
</>
)}

{photographs.length > 0 && (
<script
type="application/json"
id="gallery-photos"
set:html={JSON.stringify(modalPhotos)}
/>
)}
</main>

<style>
.gallery-detail {
width: min(1200px, 92%) ;
margin: 0 auto          ;
padding: 2rem 0 4rem    ;
}

.breadcrumb {
margin-bottom: 1.5rem ;
font-size: 0.9rem     ;
}

.breadcrumb a,
.back-link a {
color: inherit             ;
text-underline-offset: 3px ;
}

.gallery-header {
margin-bottom: 2rem ;
}

.gallery-header p {
max-width: 700px    ;
line-height: 1.6    ;
}

.masonry {
display: flex           ;
align-items: flex-start ;
gap: 30px               ;
}

.masonry__col {
display: grid   ;
flex: 1         ;
min-width: 0    ;
gap: 30px       ;
}

.masonry figure {
min-width: 0      ;
margin: 0         ;
}

.masonry img {
display: block    ;
width: 100%       ;
height: auto      ;
border: 1px solid #ddd;
}

.masonry figcaption {
display: flex          ;
flex-direction: column ;
gap: 0.25rem           ;
margin-top: 0.5rem     ;
font-size: 0.9rem      ;
line-height: 1.45      ;
}

.masonry--tablet,
.masonry--mobile {
display: none      ;
}

.back-link {
margin-top: 2.5rem ;
}

@media (max-width: 900px) {
.masonry--desktop {
display: none               ;
}

.masonry--tablet {
display: flex      ;
}

.masonry {
gap: 20px  ;
}

.masonry__col {
gap: 24px       ;
}
}

@media (max-width: 520px) {
.masonry--tablet {
display: none               ;
}

.masonry--mobile {
display: flex      ;
}

.masonry {
gap: 0     ;
}

.masonry__col {
gap: 28px       ;
}
}

/* ===== Lightbox ===== */
.photo-link {
cursor: zoom-in ;
}

/* Caption shown at the bottom of the PhotoSwipe viewer. */
.pswp__custom-caption {
position: absolute        ;
left: 0                   ;
right: 0                  ;
bottom: 16px              ;
display: flex             ;
flex-direction: column    ;
gap: 0.15rem              ;
padding: 0 1rem           ;
text-align: center        ;
color: #fff               ;
font-size: 0.95rem        ;
line-height: 1.4          ;
text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
}

.pswp__custom-caption:empty {
display: none ;
}

.pswp__custom-caption span {
opacity: 0.8 ;
}
</style>

<script>
// Gallery lightbox powered by PhotoSwipe: touch swipe + pinch-zoom on
// mobile, arrow-key and on-screen button navigation on desktop, with
// smooth transitions. The underlying photo-page links still work when
// JavaScript is unavailable.
import PhotoSwipeLightbox from "photoswipe/lightbox";

interface ModalPhoto {
slug: string;
imageUrl: string;
width: number;
height: number;
alt: string;
title: string;
location: string;
}

const dataEl = document.getElementById("gallery-photos");

if (dataEl?.textContent) {
const photos: ModalPhoto[] = JSON.parse(dataEl.textContent);

const lightbox = new PhotoSwipeLightbox({
dataSource: photos.map((p) => ({
// Ask Sanity's CDN for a right-sized, auto-formatted rendition.
src: `${p.imageUrl}?auto=format&fit=max&w=2000`,
width: p.width,
height: p.height,
alt: p.alt,
})),
pswpModule: () => import("photoswipe"),
bgOpacity: 0.95,
loop: true,
});

// Title / location caption pinned below each photo.
lightbox.on("uiRegister", () => {
lightbox.pswp?.ui?.registerElement({
name: "custom-caption",
className: "pswp__custom-caption",
appendTo: "root",
onInit: (el, pswp) => {
const update = () => {
const photo = photos[pswp.currIndex];
el.replaceChildren();
if (photo?.title) {
const strong = document.createElement("strong");
strong.textContent = photo.title;
el.appendChild(strong);
}
if (photo?.location) {
const span = document.createElement("span");
span.textContent = photo.location;
el.appendChild(span);
}
};
pswp.on("change", update);
update();
},
});
});

lightbox.init();

// Open the lightbox from a grid photo link.
document
.querySelectorAll<HTMLAnchorElement>(".photo-link[data-photo-slug]")
.forEach((link) => {
link.addEventListener("click", (e) => {
// Let modified / middle clicks fall through to the real page.
if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) {
return;
}
const slug = link.getAttribute("data-photo-slug");
const index = photos.findIndex((p) => p.slug === slug);
if (index === -1) return;
e.preventDefault();
lightbox.loadAndOpen(index);
});
});
}
</script>
</BaseLayout>
