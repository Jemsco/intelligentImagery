---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sanityClient } from "../lib/sanity";
import ArticleCard from "../components/ArticleCard.astro";

const articles = await sanityClient.fetch(`
*[_type == "article" && defined(slug.current)] | order(publishedAt desc) {
title,
"slug": slug.current,
excerpt,
publishedAt,
featuredImage {
alt,
"url": asset->url,
"width": asset->metadata.dimensions.width,
"height": asset->metadata.dimensions.height
}
}
`)                                                                         ;

const defaultImage = "/images/blog-default.jpg";

const introductionSlug = "more-than-a-photograph";
const remainingArticles = articles.filter((article) => article.slug !== introductionSlug) ;

const displayArticles = import.meta.env.DEV ? [...remainingArticles] : remainingArticles ;

const latestArticle = displayArticles[0]          ;
const previousArticles = displayArticles.slice(1) ;

function distributeArticles(articles, columnCount) {
const columns = Array.from({ length: columnCount }, () => []) ;
articles.forEach((article, index) => {
columns[index % columnCount].push(article)                    ;
})                                                            ;
return columns                                                ;
}

// We only need the 3-column array structure for the DOM template
const desktopColumns = distributeArticles(previousArticles, 3)    ;
---

<BaseLayout title="Blog | Intelligent Imagery" description="Photography advice, techniques, equipment, projects, and lessons learned along the way.">
<main class="blog-page">
<header class="blog-header">
<div class="blog-hero">
<img src="/images/blog-hero.jpg" alt="" fetchpriority="high" />
</div>
<div class="blog-intro">
<h1>Photography, Without the Guesswork.</h1>
<p>Advice, techniques, equipment, projects, and lessons learned along the way.</p>
<a href="/blog/more-than-a-photograph/" class="blog-origin">
How It All Started <span aria-hidden="true">→</span>
</a>
</div>
</header>

{latestArticle && (
<section class="latest-article" aria-labelledby="latest-heading">
<h2 id="latest-heading" class="section-heading">Latest Article</h2>
<article class="featured-article">
<a href={`/blog/${latestArticle.slug}/`} class:list={["featured-thumbnail", !latestArticle.featuredImage?.url && "article-thumbnail--fallback"]} aria-label={`Read ${latestArticle.title}`}>
<img src={latestArticle.featuredImage?.url || defaultImage} alt={latestArticle.featuredImage?.url ? latestArticle.featuredImage.alt || "" : ""} loading="lazy" />
</a>
<div class="featured-content">
<p class="article-category">PHOTOGRAPHY</p>
<h3>
<a href={`/blog/${latestArticle.slug}/`}>{latestArticle.title}</a>
</h3>
{latestArticle.excerpt && <p class="article-excerpt">{latestArticle.excerpt}</p>}
<a href={`/blog/${latestArticle.slug}/`} class="read-more" aria-label={`Read the full article: ${latestArticle.title}`}>
Read article <span aria-hidden="true">→</span>
</a>
</div>
</article>
</section>
)}

{previousArticles.length > 0 && (
<section class="previous-articles" aria-labelledby="previous-heading">
<h2 id="previous-heading" class="section-heading">Previous Articles</h2>
<div class="masonry">
{desktopColumns.map((column) => (
<div class="masonry__col">
{column.map((article) => (
<ArticleCard article={article} defaultImage={defaultImage} />
))}
</div>
))}
</div>
</section>
)}
</main>
</BaseLayout>

<style>
/* Page layout */
.blog-page {
width: min(100% - 2rem, 1100px) ;
margin-inline: auto             ;
}
.blog-header {
margin-bottom: 3rem             ;
}

/* Hero */
.blog-hero {
width: 100%          ;
aspect-ratio: 16 / 9 ;
overflow: hidden     ;
background:          #171717;
}
.blog-hero img {
display: block       ;
width: 100%          ;
height: 100%         ;
object-fit: cover    ;
}

/* Introduction */
.blog-intro {
padding: 2rem 0 1.5rem               ;
}
.blog-intro h1 {
margin: 0 0 0.75rem                  ;
font-size: clamp(2rem, 4vw, 3.25rem) ;
line-height: 1.15                    ;
letter-spacing: -0.035em             ;
}
.blog-intro > p {
max-width: 650px                     ;
margin: 0                            ;
color:                               #b8b8b8;
font-size: 1.05rem                   ;
line-height: 1.7                     ;
}
.blog-origin {
display: inline-block                ;
margin-top: 1.25rem                  ;
color: inherit                       ;
font-size: 1.2rem                    ;
font-weight: 600                     ;
text-decoration: none                ;
}
.blog-origin:hover {
text-decoration: underline           ;
text-underline-offset: 4px           ;
}
.blog-origin:focus-visible {
outline: 2px solid                   #c5af91;
outline-offset: 4px                  ;
}

/* Section headings */
.section-heading {
margin: 0 0 1.5rem                    ;
font-size: clamp(1.5rem, 2.5vw, 2rem) ;
line-height: 1.25                     ;
}

/* Latest article */
.latest-article {
margin: 0 0 3.5rem                                    ;
}
.featured-article {
display: grid                                         ;
grid-template-columns: 200px minmax(0, 1fr)           ;
align-items: start                                    ;
gap: 1.5rem                                           ;
padding-bottom: 2rem                                  ;
border-bottom: 1px solid                              #383838;
}
.featured-thumbnail {
display: block                                        ;
border-radius: 8px                                    ;
overflow: hidden                                      ;
background:                                           #242424;
}
.featured-thumbnail img {
display: block                                        ;
width: 100%                                           ;
height: auto                                          ;
}
.featured-thumbnail.article-thumbnail--fallback img {
opacity: 0.5                                          ;
}
.featured-content {
min-width: 0                                          ;
}
.featured-content h3 {
margin: 0 0 0.75rem                                   ;
font-size: clamp(1.5rem, 3vw, 2.25rem)                ;
line-height: 1.25                                     ;
}
.featured-content h3 a {
color: inherit                                        ;
text-decoration: none                                 ;
}
.featured-content h3 a:hover {
text-decoration: underline                            ;
text-underline-offset: 4px                            ;
}
.article-category {
margin: 0 0 0.5rem                                    ;
color:                                                #c5af91;
font-size: 0.75rem                                    ;
font-weight: 600                                      ;
letter-spacing: 0.1em                                 ;
}
.article-excerpt {
margin: 0 0 0.9rem                                    ;
color:                                                #b8b8b8;
line-height: 1.7                                      ;
}
.read-more {
display: inline-block                                 ;
color: inherit                                        ;
font-size: 0.9rem                                     ;
font-weight: 600                                      ;
text-decoration: none                                 ;
}
.read-more:hover {
text-decoration: underline                            ;
text-underline-offset: 4px                            ;
}
.featured-thumbnail:focus-visible,
.featured-content a:focus-visible {
outline: 2px solid                                    #c5af91;
outline-offset: 4px                                   ;
}

/* Previous articles: masonry columns */
.masonry {
display: flex                            ;
align-items: flex-start                  ;
gap: 1.5rem                              ;
margin-bottom: 3rem                      ;
}
.masonry__col {
flex: 1                                  ;
min-width: 0                             ;
display: grid                            ;
align-content: start                     ;
gap: 2.5rem                              ;
}

/* Empty state */
.empty-message {
margin: 3rem 0     ;
text-align: center ;
}

/* Tablet & Mobile (All screens under 800px) */
@media (max-width: 800px) {
.featured-article {
gap: 1.25rem                                                       ;
}
/* Neutralize the multi-column distribution container structure */
.masonry {
display: flex                                                      ;
flex-direction: column                                             ;
gap: 2.5rem                                                        ;
}
.masonry__col {
display: contents                                                  ;
}
}

/* Mobile unique variations */
@media (max-width: 600px) {
.blog-page {
width: min(100% - 1.5rem, 1100px) ;
}
.blog-header {
margin-bottom: 1.5rem             ;
}
.blog-hero {
aspect-ratio: 16 / 9              ;
}
.blog-intro {
padding: 1.5rem 0                 ;
}
.featured-article {
grid-template-columns: 1fr        ;
gap: 1.25rem                      ;
}
.featured-thumbnail {
width: 100%                       ;
max-width: 200px                  ;
}
.article-excerpt {
font-size: 0.9rem                 ;
line-height: 1.55                 ;
}
}
</style>
