
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sanityClient } from "../lib/sanity";

const articles = await sanityClient.fetch(`
  *[_type == "article" && defined(slug.current)]
  | order(publishedAt desc) {
    title,
    "slug": slug.current,
    excerpt,
    publishedAt,
    featuredImage {
      alt,
      "url": asset->url
    }
  }
`);

const formattedDate = (date) =>
  date
    ? new Date(date).toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
      })
    : "";
---

<BaseLayout
  title="Blog"
  description="Photography, places, technology, and other thoughts from Intelligent Imagery."
>
  <h1 class="page-title">Blog</h1>

  {articles.length === 0 ? (
    <p class="empty-message">
      Articles are coming soon. Please check back later.
    </p>
  ) : (
    <div class="article-list">
      {articles.map((article) => (
        <article class="article-card">
          {article.featuredImage?.url && (
            <a href={`/blog/${article.slug}/`} class="article-image-link">
              <img
                src={article.featuredImage.url}
                alt={article.featuredImage.alt || ""}
                loading="lazy"
              />
            </a>
          )}

          <div class="article-content">
            <h2>
              <a href={`/blog/${article.slug}/`}>{article.title}</a>
            </h2>

            {article.publishedAt && (
              <p class="article-date">
                <time datetime={article.publishedAt}>
                  {formattedDate(article.publishedAt)}
                </time>
              </p>
            )}

            {article.excerpt && <p>{article.excerpt}</p>}

            <a href={`/blog/${article.slug}/`} class="read-more">
              Read article →
            </a>
          </div>
        </article>
      ))}
    </div>
  )}

  <style>
    .article-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
      gap: 2rem;
      margin: 2rem 0;
    }

    .article-card {
      min-width: 0;
    }

    .article-image-link img {
      display: block;
      width: 100%;
      height: auto;
    }

    .article-content h2 {
      margin: 1rem 0 0.5rem;
      font-size: 1.5rem;
    }

    .article-content h2 a {
      color: inherit;
      text-decoration: none;
    }

    .article-content h2 a:hover,
    .read-more:hover {
      text-decoration: underline;
    }

    .article-date {
      color: #666;
      font-size: 0.9rem;
      margin: 0.5rem 0;
    }

    .read-more {
      font-weight: 600;
    }

    .empty-message {
      text-align: center;
      margin: 3rem 0;
    }
  </style>
</BaseLayout>
