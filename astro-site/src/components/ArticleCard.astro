---
const { article, defaultImage } = Astro.props ;
---

<article class="grid-article">
<a
href={`/blog/${article.slug}/`}
class:list={[
"grid-thumbnail",
!article.featuredImage?.url && "article-thumbnail--fallback",
]}
aria-label={`Read ${article.title}`}
>
<img
src={article.featuredImage?.url || defaultImage}
alt={article.featuredImage?.url ? article.featuredImage.alt || "" : ""}
loading="lazy"
/>
</a>

<div class="grid-content">
<p class="article-category">PHOTOGRAPHY</p>

<h3>
<a href={`/blog/${article.slug}/`}>{article.title}</a>
</h3>

{article.excerpt && (
<p class="article-excerpt">{article.excerpt}</p>
)}
</div>
</article>
<style>
/* Article card */
.grid-article {
min-width: 0                                     ;
}

/* Thumbnail */
.grid-thumbnail {
display: block      ;
aspect-ratio: 4 / 3 ;
margin-bottom: 1rem ;
overflow: hidden    ;
background:         #242424;
}

.grid-thumbnail :global(img) {
display: block                 ;
width: 100%                    ;
height: 100%                   ;
object-fit: cover              ;
}

.grid-thumbnail.article-thumbnail--fallback img {
opacity: 0.5                                      ;
}

/* Card content */
.grid-content {
min-width: 0       ;
}

.article-category {
margin: 0 0 0.5rem    ;
color:                #c5af91;
font-size: 0.75rem    ;
font-weight: 600      ;
letter-spacing: 0.1em ;
}

.grid-content h3 {
margin: 0 0 0.65rem ;
font-size: 1.25rem  ;
line-height: 1.35   ;
}

.grid-content h3 a {
color: inherit        ;
text-decoration: none ;
}

.grid-content h3 a:hover {
text-decoration: underline ;
text-underline-offset: 4px ;
}

.article-excerpt {
margin: 0 0 0.9rem ;
color:             #b8b8b8;
line-height: 1.7   ;
}

/* Keyboard accessibility */
.grid-thumbnail:focus-visible,
.grid-content a:focus-visible {
outline: 2px solid              #c5af91;
outline-offset: 4px             ;
}

/* Mobile */
@media (max-width: 600px) {
.article-excerpt {
font-size: 0.9rem           ;
line-height: 1.55           ;
}
}
</style>
