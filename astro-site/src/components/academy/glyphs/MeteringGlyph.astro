---
/**
 * Metering glyph — a hexagon split into a triangular mesh with a solid spot
 * at its centre.
 *
 * The mesh stands for the camera weighing light across many zones (matrix /
 * center-weighted); the filled centre hexagon is the spot meter. Geometry is
 * computed so the mesh stays exact. Draws with `currentColor`. From the Step 2
 * mockup.
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;

const cx = 60;
const cy = 60;
// Flat-top hexagon corners at a given radius.
const hex = (r: number): [number, number][] =>
	[0, 60, 120, 180, 240, 300].map((d) => {
		const a = (d * Math.PI) / 180;
		return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
	});
const fmt = (pts: [number, number][]) =>
	pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(" ");
const mid = (p: [number, number], q: [number, number]): [number, number] => [
	(p[0] + q[0]) / 2,
	(p[1] + q[1]) / 2,
];

const outer = hex(52);
const inner = hex(26); // vertices sit at the midpoints of the spokes
const ring = hex(17);
const spot = hex(10);
// Midpoint of each outer edge — the mesh connects these to the inner hexagon.
const edgeMids = outer.map((v, i) => mid(v, outer[(i + 1) % 6]));
---

<svg
	class:list={["glyph", className]}
	viewBox="0 0 120 120"
	role="img"
	aria-label="A hexagon split into a triangular mesh with a solid spot at its centre"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linejoin="round"
>
	<title>Metering</title>
	<polygon points={fmt(outer)}></polygon>
	<polygon points={fmt(inner)}></polygon>
	{
		outer.map((v) => (
			<line x1={cx} y1={cy} x2={v[0].toFixed(1)} y2={v[1].toFixed(1)} />
		))
	}
	{
		edgeMids.map((m, i) => (
			<>
				<line
					x1={inner[i][0].toFixed(1)}
					y1={inner[i][1].toFixed(1)}
					x2={m[0].toFixed(1)}
					y2={m[1].toFixed(1)}
				/>
				<line
					x1={m[0].toFixed(1)}
					y1={m[1].toFixed(1)}
					x2={inner[(i + 1) % 6][0].toFixed(1)}
					y2={inner[(i + 1) % 6][1].toFixed(1)}
				/>
			</>
		))
	}
	<polygon points={fmt(ring)}></polygon>
	<polygon points={fmt(spot)} fill="currentColor" stroke="none"></polygon>
</svg>
