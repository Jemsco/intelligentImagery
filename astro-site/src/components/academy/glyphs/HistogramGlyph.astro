---
/** Histogram — tonal bars rising to a peak over a baseline. */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
// [x, height] per bar; baseline sits at y=40.
const bars: [number, number][] = [
	[5, 8],
	[11, 16],
	[17, 26],
	[23, 32],
	[29, 26],
	[35, 16],
	[41, 8],
];
---

<svg
	class:list={["glyph", className]}
	viewBox="0 0 48 48"
	role="img"
	aria-label="A row of tonal bars rising to a central peak above a baseline"
	fill="currentColor"
	stroke="none"
>
	<title>Histogram</title>
	{
		bars.map(([x, h]) => (
			<rect x={x} y={40 - h} width="4" height={h} rx="1" />
		))
	}
	<line
		x1="3"
		y1="41.25"
		x2="45"
		y2="41.25"
		stroke="currentColor"
		stroke-width="1.5"
		stroke-linecap="round"></line>
</svg>
