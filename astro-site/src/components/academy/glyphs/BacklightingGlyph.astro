---
/** Backlighting — a subject in silhouette with light coming from behind. */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg
	class:list={["glyph", className]}
	viewBox="0 0 48 48"
	role="img"
	aria-label="A dark subject with light rays coming from behind it"
	fill="none"
	stroke="currentColor"
	stroke-width="2.5"
	stroke-linecap="round"
>
	<title>Back lighting</title>
	<!-- light behind, around the top -->
	<line x1="24" y1="9" x2="24" y2="4"></line>
	<line x1="14" y1="12" x2="10" y2="8"></line>
	<line x1="34" y1="12" x2="38" y2="8"></line>
	<line x1="8" y1="21" x2="3" y2="19"></line>
	<line x1="40" y1="21" x2="45" y2="19"></line>
	<!-- subject in silhouette -->
	<circle cx="24" cy="29" r="10" fill="currentColor" stroke="none"></circle>
</svg>
