---
/**
 * Direction glyph — three chevrons pointing the way the light travels.
 * Draws with `currentColor`. (Step 3 "Direction" card.)
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg
	class:list={["glyph", className]}
	viewBox="0 0 120 80"
	role="img"
	aria-label="Three chevrons pointing to the right"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<title>Direction</title>
	<path d="M20 16 L44 40 L20 64"></path>
	<path d="M48 16 L72 40 L48 64"></path>
	<path d="M76 16 L100 40 L76 64"></path>
</svg>
