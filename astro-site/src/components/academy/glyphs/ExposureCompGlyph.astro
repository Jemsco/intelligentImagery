---
/** Exposure Compensation — a −/+ scale with a marker nudged toward plus. */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg
	class:list={["glyph", className]}
	viewBox="0 0 48 48"
	role="img"
	aria-label="A minus-to-plus exposure scale with a marker above it"
	fill="none"
	stroke="currentColor"
	stroke-width="2.5"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<title>Exposure compensation</title>
	<!-- scale -->
	<line x1="7" y1="31" x2="41" y2="31"></line>
	<line x1="13" y1="28" x2="13" y2="31"></line>
	<line x1="24" y1="28" x2="24" y2="31"></line>
	<line x1="35" y1="28" x2="35" y2="31"></line>
	<!-- marker -->
	<path d="M31 18 L27 24 L35 24 Z" fill="currentColor" stroke="none"></path>
	<!-- minus (dark end) -->
	<line x1="7" y1="14" x2="13" y2="14"></line>
	<!-- plus (bright end) -->
	<line x1="35" y1="11" x2="35" y2="17"></line>
	<line x1="32" y1="14" x2="38" y2="14"></line>
</svg>
