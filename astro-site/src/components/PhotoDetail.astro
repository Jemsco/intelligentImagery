---
// Single photograph page body, shared by top-level and nested galleries.
// `category` is supplied only when the gallery is nested, so the breadcrumb
// can read Gallery / Places / Utah / <Photo>.
interface Crumb {
  title: string;
  href: string;
}

interface Props {
  title: string;
  location?: string;
  altText?: string;
  description?: string;
  imageUrl: string;
  galleryTitle: string;
  galleryHref: string;
  category?: Crumb;
}

const {
  title,
  location,
  altText,
  description,
  imageUrl,
  galleryTitle,
  galleryHref,
  category,
} = Astro.props;
---

<main class="photo-detail">
  <nav aria-label="Breadcrumb" class="breadcrumbs">
    <a href="/gallery/">Gallery</a>
    <span aria-hidden="true"> / </span>
    {category && (
      <>
        <a href={category.href}>{category.title}</a>
        <span aria-hidden="true"> / </span>
      </>
    )}
    <a href={galleryHref}>{galleryTitle}</a>
    <span aria-hidden="true"> / </span>
    <span aria-current="page">{title}</span>
  </nav>

  <article>
    <h1>{title}</h1>

    {location && <p class="photo-location">{location}</p>}

    <figure>
      <img src={imageUrl} alt={altText || title || ""} />
      {description && <figcaption>{description}</figcaption>}
    </figure>

    <p class="back-link">
      <a href={galleryHref}>Back to {galleryTitle}</a>
    </p>
  </article>
</main>

<style>
  .photo-detail {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
  }

  .breadcrumbs {
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  .breadcrumbs a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .photo-detail h1 {
    margin-bottom: 0.5rem;
  }

  .photo-location {
    margin-top: 0;
    color: #666;
  }

  figure {
    margin: 2rem 0;
  }

  figure img {
    display: block;
    max-width: 100%;
    width: auto;
    height: auto;
    margin: 0 auto;
    border: 1px solid #ddd;
  }

  figcaption {
    margin-top: 0.75rem;
    line-height: 1.6;
  }

  .back-link {
    margin-top: 2rem;
  }

  a:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 4px;
  }
</style>
